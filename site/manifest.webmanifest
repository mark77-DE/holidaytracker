{
  "name": "Holidaytracker",
  "short_name": "Holidaytracker",
  "description": "Urlaube, Wandertage und GPX-Touren an einem Ort sammeln.",
  "lang": "de",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f5f5ef",
  "theme_color": "#173c35",
  "icons": [
    {"src": "web-icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "web-icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"},
    {"src": "web-icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "share_target": {
    "action": "./share-target", "method": "POST", "enctype": "multipart/form-data",
    "params": {"files": [{"name": "gpx", "accept": ["application/gpx+xml", ".gpx", "application/octet-stream", "text/xml", "application/xml"]}]}
  }
}
